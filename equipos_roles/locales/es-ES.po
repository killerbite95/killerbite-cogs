#: equipos_roles.py:1003
msgid "Registered teams"
msgstr "Equipos registrados"

#: equipos_roles.py:1016 equipos_roles.py:205 equipos_roles.py:662 equipos_roles.py:1370 equipos_roles.py:1396
msgid "There are no teams registered yet. Tell an admin."
msgstr "Todavía no hay equipos registrados. Avisa a un admin."

#: equipos_roles.py:1018 equipos_roles.py:1051 equipos_roles.py:487 equipos_roles.py:1516 equipos_roles.py:1519
msgid "I cannot post in that channel. Check my permissions there."
msgstr "No puedo publicar en ese canal. Revisa mis permisos."

#: equipos_roles.py:1045
msgid "The team name must be between 2 and 64 characters."
msgstr "El nombre del equipo debe tener entre 2 y 64 caracteres."

#: equipos_roles.py:1047
msgid "That role cannot be assigned by the bot."
msgstr "Ese rol no lo puede asignar el bot."

#: equipos_roles.py:1049
msgid "That role is above my highest role. Move my role higher."
msgstr "Ese rol está por encima de mi rol más alto. Sube mi rol."

#: equipos_roles.py:1344
msgid "**Team roles**\n`{pedir}` — request a team role.\n`{lista}` — see the registered teams.\n`{admin}` — open the admin board (admin).\n`{panel}` — publish the request panel (admin).\n`{config}` — show or change the settings (admin).\n`{solicitudes}` — list requests (admin)."
msgstr "**Roles de equipo**\n`{pedir}` — pide el rol de un equipo.\n`{lista}` — consulta los equipos registrados.\n`{admin}` — abre el panel de administración (admin).\n`{panel}` — publica el panel de solicitudes (admin).\n`{config}` — muestra o cambia los ajustes (admin).\n`{solicitudes}` — lista las solicitudes (admin)."

#: equipos_roles.py:1584
msgid "🛠️ Team role admin"
msgstr "🛠️ Administración de roles de equipo"

#: equipos_roles.py:1585
msgid "Everything from here: publish the panel, register or delete teams, review requests and change the settings."
msgstr "Todo desde aquí: publica el panel, registra o elimina equipos, revisa solicitudes y cambia los ajustes."

