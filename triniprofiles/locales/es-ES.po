#: profiles.py:876
msgid "Delete a saved preset."
msgstr "Eliminar un preset guardado."

#: profiles.py:881
msgid "That preset doesn't exist."
msgstr "No existe ese preset."

#: profiles.py:883
msgid "It can only be deleted from the server that created it."
msgstr "Solo se puede borrar desde el servidor que lo creo."

#: profiles.py:886
msgid "🗑 Preset **{name}** deleted."
msgstr "🗑 Preset **{name}** eliminado."

#: profiles.py:890
msgid "Export modules and active cog settings to JSON."
msgstr "Exportar modulos y configuracion de los cogs activos a JSON."

#: profiles.py:896
msgid ""
"🏠 Server: **{escape_markdown}** (`{guild_id}`)\n"
"🕒 {format_dt}\n"
"📤 Exported **{count}** cogs and **{value}** modules.\n"
"⚠️ The file contains server settings, share it carefully."
msgstr ""
"🏠 Servidor: **{escape_markdown}** (`{guild_id}`)\n"
"🕒 {format_dt}\n"
"📤 Exportados **{count}** cogs y **{value}** modulos.\n"
"⚠️ El archivo contiene configuracion del servidor, compartelo con cuidado."

#: profiles.py:901
msgid "📬 I've sent you the export by DM."
msgstr "📬 Te he enviado el export por mensaje privado."

#: profiles.py:903
msgid "I can't DM you. Enable DMs or use the slash version of the command."
msgstr ""
"No puedo enviarte mensajes privados. Activalos o usa la version slash del "
"comando."

#: profiles.py:907
msgid "Import a JSON generated with `profile export`."
msgstr "Importar un JSON generado con `profile export`."

#: profiles.py:911
msgid "Attach the exported JSON file."
msgstr "Adjunta el archivo JSON exportado."

#: profiles.py:913
msgid "The file is too large."
msgstr "El archivo es demasiado grande."

#: profiles.py:917
msgid "It isn't valid JSON."
msgstr "No es un JSON valido."

#: profiles.py:919
msgid "The file isn't a Trini Profiles export."
msgstr "El archivo no es un export de Trini Profiles."

#: profiles.py:921
msgid "The file is corrupted (modules or cogs with an invalid format)."
msgstr "El archivo esta dañado (modulos o cogs con formato incorrecto)."

#: profiles.py:927
msgid "📥 Import settings"
msgstr "📥 Importar configuracion"

#: profiles.py:930
msgid ""
"Source: **{get}** (`{get2}`)\n"
"Profile: `{get3}` · Security: `{get4}`\n"
"\n"
"**Modules:** {value}\n"
"**Cog settings:** {value2}\n"
"\n"
"Channels and roles are re-mapped by name if the server is different.\n"
"The current settings of those cogs will be overwritten."
msgstr ""
"Origen: **{get}** (`{get2}`)\n"
"Perfil: `{get3}` · Seguridad: `{get4}`\n"
"\n"
"**Modulos:** {value}\n"
"**Configuracion de cogs:** {value2}\n"
"\n"
"Los canales y roles se re-mapean por nombre si el servidor es distinto.\n"
"La configuracion actual de esos cogs se sobrescribira."

#: profiles.py:932
msgid ""
"\n"
"\n"
"⚠️ **Full copy (no Trini support):** "
msgstr ""
"\n"
"\n"
"⚠️ **Copia completa (sin soporte Trini):** "

#: profiles.py:934
msgid ". It may include runtime data from the source server."
msgstr ". Puede incluir datos de funcionamiento del servidor de origen."

#: profiles.py:946
msgid "✅ Import completed."
msgstr "✅ Importacion completada."
