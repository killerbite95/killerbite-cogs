msgid "Add a member to your team (captain only)."
msgstr "Añade un miembro a tu equipo (solo el capitán)."

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancelled."
msgstr "Cancelado."

msgid "Create a team. You become its captain."
msgstr "Crea un equipo. Tú serás el capitán."

msgid "Delete"
msgstr "Eliminar"

msgid "Delete the team {name}?"
msgstr "¿Eliminar el equipo {name}?"

msgid "Delete your team (captain only)."
msgstr "Elimina tu equipo (solo el capitán)."

msgid "Its {count} members lose the team. This cannot be undone."
msgstr "Sus {count} miembros pierden el equipo. No se puede deshacer."

msgid "Leave your team."
msgstr "Sal de tu equipo."

msgid "List the teams of this server."
msgstr "Lista los equipos de este servidor."

msgid "Manage scrim teams."
msgstr "Gestiona los equipos de scrims."

msgid "Only the captain can do this."
msgstr "Solo el capitán puede hacer esto."

msgid "Player"
msgstr "Jugador"

msgid "Remove a member from your team (captain only)."
msgstr "Elimina un miembro de tu equipo (solo el capitán)."

msgid "Role must be `player` or `sub`."
msgstr "El rol debe ser `player` o `sub`."

msgid "Scrim board for League of Legends: teams, sign-ups and match records."
msgstr "Board de scrims de League of Legends: equipos, apuntados y registro de partidas."

msgid "Scrims LoL"
msgstr "Scrims LoL"

msgid "Scrims LoL · Team #{id}"
msgstr "Scrims LoL · Equipo #{id}"

msgid "Scrims of League of Legends."
msgstr "Scrims de League of Legends."

msgid "Show a team and its roster."
msgstr "Muestra un equipo y su plantilla."

msgid "Sub"
msgstr "Suplente"

msgid "That member is already the captain."
msgstr "Ese miembro ya es el capitán."

msgid "That user cannot be added to a team."
msgstr "Ese usuario no se puede añadir a un equipo."

msgid "The captain cannot be removed. Transfer the captaincy first."
msgstr "No se puede eliminar al capitán. Transfiere primero la capitanía."

msgid "The roster is full (15 members)."
msgstr "La plantilla está llena (15 miembros)."

msgid "The team name must be between 2 and 32 characters."
msgstr "El nombre del equipo debe tener entre 2 y 32 caracteres."

msgid "There is already a team named **{name}**."
msgstr "Ya existe un equipo con el nombre **{name}**."

msgid "There is already a team with the tag **{tag}**."
msgstr "Ya existe un equipo con la etiqueta **{tag}**."

msgid "This command only works in a server."
msgstr "Este comando solo funciona en un servidor."

msgid "This confirmation is not for you."
msgstr "Esta confirmación no es para ti."

msgid "This server has no teams yet. Create the first one with `{cmd}`."
msgstr "Este servidor todavía no tiene equipos. Crea el primero con `{cmd}`."

msgid "This team no longer exists."
msgstr "Este equipo ya no existe."

msgid "Transfer the captaincy to another member."
msgstr "Transfiere la capitanía a otro miembro."

msgid "You are already in the team **{team}**. Leave it before creating another one."
msgstr "Ya estás en el equipo **{team}**. Sal de él antes de crear otro."

msgid "You cannot leave a team you captain. Transfer the captaincy or delete the team."
msgstr "No puedes salir de un equipo que capitaneas. Transfiere la capitanía o elimina el equipo."

msgid "You do not belong to any team. Create one with `{cmd}`."
msgstr "No perteneces a ningún equipo. Crea uno con `{cmd}`."

msgid "{index}. **{name}** — {captain} · {count} members"
msgstr "{index}. **{name}** — {captain} · {count} miembros"

msgid "{member} does not belong to any team."
msgstr "{member} no pertenece a ningún equipo."

msgid "{member} is already in the team **{team}**."
msgstr "{member} ya está en el equipo **{team}**."

msgid "{member} is not in your team."
msgstr "{member} no está en tu equipo."

msgid "{pre}\n\nVersion: {version}"
msgstr "{pre}\n\nVersión: {version}"

msgid "✅ Team **{name}** created. You are the captain."
msgstr "✅ Equipo **{name}** creado. Eres el capitán."

msgid "✅ Team **{name}** deleted."
msgstr "✅ Equipo **{name}** eliminado."

msgid "✅ You left the team **{name}**."
msgstr "✅ Has salido del equipo **{name}**."

msgid "✅ {member} is now the captain of **{name}**."
msgstr "✅ {member} es ahora el capitán de **{name}**."

msgid "✅ {member} joined the team as {role}."
msgstr "✅ {member} se ha unido al equipo como {role}."

msgid "✅ {member} was removed from the team."
msgstr "✅ {member} se ha eliminado del equipo."

msgid "🎯 Starters ({count}/{total})"
msgstr "🎯 Titulares ({count}/{total})"

msgid "🏷️ Tag"
msgstr "🏷️ Etiqueta"

msgid "📋 Teams ({count})"
msgstr "📋 Equipos ({count})"

msgid "… and {n} more."
msgstr "… y {n} más."

msgid "🛡️ {name}"
msgstr "🛡️ {name}"

msgid "🛡️ {name} · [{tag}]"
msgstr "🛡️ {name} · [{tag}]"

msgid "🪑 Subs ({count})"
msgstr "🪑 Suplentes ({count})"

msgid "Team"
msgstr "Equipo"

msgid "Mix"
msgstr "Mix"

msgid "Open"
msgstr "Abierta"

msgid "Closed"
msgstr "Cerrada"

msgid "Matched"
msgstr "Emparejada"

msgid "Cancelled"
msgstr "Cancelada"

msgid "Expired"
msgstr "Caducada"

msgid "Join"
msgstr "Apuntarme"

msgid "Leave"
msgstr "Salir"

msgid "Accept as team"
msgstr "Aceptar como equipo"

msgid "Close"
msgstr "Cerrar"

msgid "Status"
msgstr "Estado"

msgid "Looking for"
msgstr "Busca"

msgid "Format"
msgstr "Formato"

msgid "Start"
msgstr "Inicio"

msgid "Rank"
msgstr "Rango"

msgid "Contact"
msgstr "Contacto"

msgid "Score"
msgstr "Marcador"

msgid "Photos"
msgstr "Fotos"

msgid "My side"
msgstr "Mi lado"

msgid "Opponent"
msgstr "Rival"

msgid "Our maps"
msgstr "Nuestros mapas"

msgid "Their maps"
msgstr "Sus mapas"

msgid "Not claimed yet."
msgstr "Todavía sin rival."

msgid "This only works in a server."
msgstr "Esto solo funciona en un servidor."

msgid "This scrim no longer exists."
msgstr "Esta scrim ya no existe."

msgid "This scrim is looking for a team: a captain has to accept it."
msgstr "Esta scrim busca un equipo: tiene que aceptarla un capitán."

msgid "This scrim is not looking for a team."
msgstr "Esta scrim no busca un equipo."

msgid "This private thread is for both sides to agree on the details."
msgstr "Este hilo privado es para que ambos lados acordéis los detalles."

msgid "That scrim does not exist."
msgstr "Esa scrim no existe."

msgid "That scrim is not open."
msgstr "Esa scrim no está abierta."

msgid "That scrim is already finished."
msgstr "Esa scrim ya está terminada."

msgid "The scrim has no opponent yet."
msgstr "La scrim todavía no tiene rival."

msgid "The scrim must start in the future."
msgstr "La scrim debe empezar en el futuro."

msgid "The side and the search must be team, mix or open."
msgstr "El lado y la búsqueda deben ser equipo, mix o abierto."

msgid "The score must look like `2-1`."
msgstr "El marcador debe tener el formato `2-1`."

msgid "The scrim is full."
msgstr "La scrim está completa."

msgid "You cannot leave your own scrim."
msgstr "No puedes salir de tu propia scrim."

msgid "This scrim already has a rival."
msgstr "Esta scrim ya tiene rival."

msgid "✅ Team accepted. Waiting for your side to be complete."
msgstr "✅ Equipo aceptado. Falta completar tu lado."

msgid "The game must be between 1 and 9."
msgstr "La partida debe estar entre 1 y 9."

msgid "You are already signed up."
msgstr "Ya estás apuntado."

msgid "You are not signed up."
msgstr "No estás apuntado."

msgid "You cannot accept your own scrim."
msgstr "No puedes aceptar tu propia scrim."

msgid "You do not belong to any team."
msgstr "No perteneces a ningún equipo."

msgid "Only the author or the staff can cancel this scrim."
msgstr "Solo el autor o el staff pueden cancelar esta scrim."

msgid "Only the participants or the staff can close this scrim."
msgstr "Solo los participantes o el staff pueden cerrar esta scrim."

msgid "Only the participants or the staff can add photos."
msgstr "Solo los participantes o el staff pueden añadir fotos."

msgid "Only the captain can accept a scrim."
msgstr "Solo el capitán puede aceptar una scrim."

msgid "Only the captain can post a scrim for the team."
msgstr "Solo el capitán puede publicar una scrim del equipo."

msgid "To post as a team you must belong to one."
msgstr "Para publicar como equipo tienes que pertenecer a uno."

msgid "There are no open scrims right now."
msgstr "Ahora mismo no hay scrims abiertas."

msgid "I cannot find the channel of that scrim."
msgstr "No encuentro el canal de esa scrim."

msgid "I could not post the image."
msgstr "No he podido publicar la imagen."

msgid "I could not read that time. Use `+90`, `+2h`, `21:00`, `15/11 21:00` or `2026-11-15 21:00`."
msgstr "No he entendido la hora. Usa `+90`, `+2h`, `21:00`, `15/11 21:00` o `2026-11-15 21:00`."

msgid "Attach the image in prefix or pass an `https://` link with `{cmd}`."
msgstr "Adjunta la imagen en prefijo o pasa un enlace `https://` con `{cmd}`."

msgid "✅ You joined the scrim."
msgstr "✅ Te has apuntado a la scrim."

msgid "✅ You joined and the scrim is complete."
msgstr "✅ Te has apuntado y la scrim está completa."

msgid "✅ You left the scrim."
msgstr "✅ Has salido de la scrim."

msgid "✅ Scrim matched. A private thread was created."
msgstr "✅ Scrim emparejada. Se ha creado un hilo privado."

msgid "✅ Scrim cancelled."
msgstr "✅ Scrim cancelada."

msgid "✅ Scrim closed with {us}-{them}."
msgstr "✅ Scrim cerrada con {us}-{them}."

msgid "✅ Screenshot saved for game {game}."
msgstr "✅ Captura guardada para la partida {game}."

msgid "🎯 Scrim #{id} · {side}"
msgstr "🎯 Scrim #{id} · {side}"

msgid "🎯 Open scrims ({count})"
msgstr "🎯 Scrims abiertas ({count})"

msgid "#{id} · {side} → {looks} · {start}"
msgstr "#{id} · {side} → {looks} · {start}"

msgid "{us} - {them}"
msgstr "{us} - {them}"

msgid "{time} ({relative})"
msgstr "{time} ({relative})"

msgid "Scrim #{id} matched"
msgstr "Scrim #{id} emparejada"

msgid "Close scrim #{id}"
msgstr "Cerrar scrim #{id}"

msgid "Scrim #{id} · Game {game}"
msgstr "Scrim #{id} · Partida {game}"

msgid "Scrims LoL · #{id}"
msgstr "Scrims LoL · #{id}"

msgid "🛡️ **{name}**"
msgstr "🛡️ **{name}**"

msgid "Publish a scrim on the board."
msgstr "Publica una scrim en la board."

msgid "List the open scrims of this server."
msgstr "Lista las scrims abiertas de este servidor."

msgid "Show one scrim."
msgstr "Muestra una scrim."

msgid "Join the opponent side of a mix or open scrim."
msgstr "Apúntate al lado rival de una scrim mix o abierta."

msgid "Leave the opponent side of a scrim."
msgstr "Sal del lado rival de una scrim."

msgid "Close a scrim with its score."
msgstr "Cierra una scrim con su marcador."

msgid "Cancel a scrim you posted."
msgstr "Cancela una scrim que hayas publicado."

msgid "Attach an optional screenshot to a game."
msgstr "Adjunta una captura opcional a una partida."

msgid "Set the timezone for interpreting scrim times."
msgstr "Define la zona horaria para interpretar las horas de las scrims."

msgid "Only admins can change the timezone."
msgstr "Solo los administradores pueden cambiar la zona horaria."

msgid "The timezone is `{tz}`."
msgstr "La zona horaria es `{tz}`."

msgid "That timezone is not valid. Use an IANA name like `Europe/Madrid`."
msgstr "Esa zona horaria no es válida. Usa un nombre IANA como `Europe/Madrid`."

msgid "✅ Timezone set to `{tz}`."
msgstr "✅ Zona horaria establecida a `{tz}`."

msgid "**Scrims**\n`{create}` — publish a scrim.\n`{list}` — see the open scrims.\n`{info}` — details of one scrim.\n`{join}` / `{leave}` — sign up or leave the opponent side.\n`{close}` — close it with a score.\n`{cancel}` — cancel it.\n`{photo}` — attach a screenshot of a game.\n`{team}` — manage teams."
msgstr "**Scrims**\n`{create}` — publica una scrim.\n`{list}` — mira las scrims abiertas.\n`{info}` — detalles de una scrim.\n`{join}` / `{leave}` — apúntate o sal del lado rival.\n`{close}` — ciérrala con el marcador.\n`{cancel}` — cancélala.\n`{photo}` — adjunta una captura de una partida.\n`{team}` — gestiona los equipos."
