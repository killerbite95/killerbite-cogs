msgstr "✅ Activo ({remaining} restante)"

#: trickortreat.py:1187
msgid "[Owner] Clear all saved game data."
msgstr "[Owner] Borrar todos los datos guardados del juego."

#: trickortreat.py:1189
msgid ""
"This will clear ALL saved data for this cog and reset it to the defaults.\n"
msgstr ""
"Esto borrará TODOS los datos guardados de este cog y los reseteará a los "
