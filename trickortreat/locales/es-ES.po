msgstr "Comes"

#: trickortreat.py:420
msgid "You scarf down"
msgstr "Devoras rápidamente"

#: trickortreat.py:421
msgid "You sigh in contentment after eating"
msgstr "Suspiras de satisfacción después de comer"

#: trickortreat.py:422
msgid "You gobble up"
msgstr "Engulles"

