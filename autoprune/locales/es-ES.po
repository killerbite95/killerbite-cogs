#: i18n_strings.py:11
msgid "Automatic cleanup of banned users' credits."
msgstr "Limpieza automatica de creditos de usuarios baneados."

#: prunebans.py:47
msgid ""
"Automatically deletes the credits of users who are still banned after some "
"days."
msgstr ""
"Borra automaticamente los creditos de los usuarios que siguen baneados "
"pasados unos dias."

#: prunebans.py:69
msgid ""
"{format_help_for_context}\n"
"\n"
"Version: {version}"
msgstr ""
"{format_help_for_context}\n"
"\n"
"Version: {version}"

#: prunebans.py:216
msgid "🧹 Banned users' credits deleted"
msgstr "🧹 Creditos de usuarios baneados eliminados"

#: prunebans.py:261
msgid "🧹 AutoPrune"
msgstr "🧹 AutoPrune"

#: prunebans.py:262
msgid ""
"Deletes the credits of users who are still banned after some days.\n"
"Bans and unbans are logged by modlog; this only reports cleanups."
msgstr ""
"Borra los creditos de los usuarios que siguen baneados pasados unos dias.\n"
"Los baneos y desbaneos los registra el modlog; aqui solo se avisa al limpiar."

#: prunebans.py:263
msgid "Status"
msgstr "Estado"

#: prunebans.py:263
msgid "🟢 Enabled"
msgstr "🟢 Activado"

#: prunebans.py:263
msgid "🔴 Disabled"
msgstr "🔴 Desactivado"

#: prunebans.py:264
msgid "Wait"
msgstr "Espera"

#: prunebans.py:264
msgid "{delay_days} days"
msgstr "{delay_days} dias"

#: prunebans.py:265
msgid "Log channel"
msgstr "Canal de logs"

#: prunebans.py:266
msgid "Tracked"
msgstr "En seguimiento"

#: prunebans.py:270 prunebans.py:275
msgid "Bank"
msgstr "Banco"

#: prunebans.py:271
msgid "Global · "
msgstr "Global · "

#: prunebans.py:271
msgid "accounts are deleted"
msgstr "se borran las cuentas"

#: prunebans.py:271
msgid ""
"⚠️ nothing is deleted (the owner can enable it with `autoprune globalbank "
"true`)"
msgstr ""
"⚠️ no se borra nada (el owner puede activarlo con `autoprune globalbank "
"true`)"

#: prunebans.py:275
msgid "Local (per server)"
msgstr "Local (por servidor)"

#: prunebans.py:287
msgid "Enable automatic cleanup in this server."
msgstr "Activar la limpieza automatica en este servidor."

#: prunebans.py:291
msgid ""
"✅ Enabled. Credits of users who are still banned will be deleted after **{days}** days.\n"
"To also track users who were already banned: `{clean_prefix}autoprune sync`."
msgstr ""
"✅ Activado. Los creditos de quien siga baneado se borraran a los **{days}** dias.\n"
"Para seguir tambien a los que ya estaban baneados: `{clean_prefix}autoprune sync`."

#: prunebans.py:296
msgid "Disable automatic cleanup (tracking is kept)."
msgstr "Desactivar la limpieza automatica (no borra el seguimiento)."

#: prunebans.py:298
msgid "⏸️ Disabled. Nothing will be deleted until you enable it again."
msgstr "⏸️ Desactivado. No se borrara nada hasta que lo vuelvas a activar."

#: prunebans.py:302
msgid ""
"Days a user must stay banned before their credits are deleted (0 = next "
"check)."
msgstr ""
"Dias que tiene que seguir baneado antes de borrar sus creditos (0 = en la "
"siguiente revision)."

#: prunebans.py:310
msgid "✅ Wait set to **{days}** days (also applied to pending bans)."
msgstr ""
"✅ Espera fijada en **{days}** dias (aplicado tambien a los baneos "
"pendientes)."

#: prunebans.py:314
msgid "Channel to report deleted credits. Without a channel it is removed."
msgstr "Canal donde avisar cuando se borran creditos. Sin canal lo quita."

#: prunebans.py:316
msgid "✅ Log channel: {channel}."
msgstr "✅ Canal de logs: {channel}."

#: prunebans.py:316
msgid "✅ Log channel removed."
msgstr "✅ Canal de logs quitado."

#: prunebans.py:320
msgid "Tracked bans and when they will be cleaned up."
msgstr "Baneos en seguimiento y cuando se limpiaran."

#: prunebans.py:323
msgid "There are no tracked bans."
msgstr "No hay baneos en seguimiento."

#: prunebans.py:330
msgid "<@{uid_str}> (`{uid_str}`) · {amount} · cleanup {when}"
msgstr "<@{uid_str}> (`{uid_str}`) · {amount} · limpieza {when}"

#: prunebans.py:332
msgid "⏳ Tracked bans ({count})"
msgstr "⏳ Baneos en seguimiento ({count})"

#: prunebans.py:338
msgid ""
"Start tracking users who were already banned (the countdown starts today)."
msgstr ""
"Empieza a seguir a los usuarios que ya estaban baneados (la cuenta atras "
"empieza hoy)."

#: prunebans.py:346
msgid "✅ {added} bans added to tracking."
msgstr "✅ {added} baneos añadidos al seguimiento."

#: prunebans.py:350
msgid ""
"Check expired bans now. With `true` it cleans every pending one without "
"waiting."
msgstr ""
"Revisar ya los baneos vencidos. Con `true` limpia todos los pendientes sin "
"esperar."

#: prunebans.py:352
msgid ""
"⚠️ The bank is global and the owner has not allowed deleting global "
"accounts."
msgstr ""
"⚠️ El banco es global y el owner no ha permitido borrar cuentas globales."

#: prunebans.py:355
msgid "🧹 Credits deleted from {count} user(s)."
msgstr "🧹 Creditos eliminados de {count} usuario(s)."

#: prunebans.py:359
msgid "Stop tracking a user (their credits will not be deleted)."
msgstr "Dejar de seguir a un usuario (no se le borraran los creditos)."

#: prunebans.py:362
msgid "✅ Removed from tracking."
msgstr "✅ Quitado del seguimiento."

#: prunebans.py:362
msgid "It was not tracked."
msgstr "No estaba en seguimiento."

#: prunebans.py:367
msgid ""
"(Owner) Allow deleting accounts when Red's bank is global.\n"
"\n"
"        With a global bank the account is the same in every server: a ban in\n"
"        one server would remove their credits everywhere.\n"
"        "
msgstr ""
"(Owner) Permitir borrar cuentas cuando el banco de Red es global.\n"
"\n"
"        Con banco global la cuenta es la misma en todos los servidores: un ban en\n"
"        un servidor le quitaria los creditos en todos.\n"
"        "

#: prunebans.py:373
msgid "✅ Global bank accounts will be deleted."
msgstr "✅ Se borraran cuentas del banco global."

#: prunebans.py:373
msgid "✅ Global bank accounts will not be touched."
msgstr "✅ No se tocaran cuentas del banco global."
