#: i18n_strings.py:11
msgid "Rust map votes using rustmaps.com."
msgstr "Votaciones de mapas de Rust usando rustmaps.com."

#: rustmaps_vote.py:43
msgid "Rust map voting using rustmaps.com. By Killerbite95"
msgstr "Votación de mapas de Rust usando rustmaps.com. By Killerbite95"

#: rustmaps_vote.py:109
msgid ""
"Invalid URL. It must look like `https://rustmaps.com/map/<size>_<seed>`."
msgstr ""
"URL no válida. Debe tener el formato "
"`https://rustmaps.com/map/<size>_<seed>`."

#: rustmaps_vote.py:117
msgid "The RustMaps API key is not set."
msgstr "La API key de RustMaps no está configurada."

#: rustmaps_vote.py:130
