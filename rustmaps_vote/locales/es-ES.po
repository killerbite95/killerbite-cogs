msgstr "🗳️ Votación de mapas de Rust"

#: rustmaps_vote.py:226
msgid "Press the button with the number of the map you prefer."
msgstr "Pulsa el botón con el número del mapa que prefieras."

#: rustmaps_vote.py:231 rustmaps_vote.py:456
msgid "Map {map_id}"
msgstr "Mapa {map_id}"

#: rustmaps_vote.py:232
msgid ""
"🌱 Seed: `{seed}` • 📏 Size: `{size}`\n"
"🗳️ **{vote_count}** vote(s) • [See map]({url})"
msgstr ""
"🌱 Seed: `{seed}` • 📏 Size: `{size}`\n"
"🗳️ **{vote_count}** voto(s) • [Ver mapa]({url})"

#: rustmaps_vote.py:237
msgid "{votes} vote(s) per person • {total_voters} voter(s) so far"
msgstr ""
"Tienes {votes} voto(s) por persona • {total_voters} votante(s) hasta ahora"

#: rustmaps_vote.py:246
msgid "🏁 Vote finished"
msgstr "🏁 Votación finalizada"

#: rustmaps_vote.py:247
msgid "No votes were cast."
msgstr "No se registró ningún voto."

#: rustmaps_vote.py:250
msgid "🏆 Map {map_id} wins!"
msgstr "🏆 ¡Gana el Mapa {map_id}!"

#: rustmaps_vote.py:252
