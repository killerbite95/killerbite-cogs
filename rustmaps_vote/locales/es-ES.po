msgid "🗺️ Maps in the session: **{map_count}/{MAX_MAPS}**"
msgstr "🗺️ Mapas en la sesión: **{map_count}/{MAX_MAPS}**"

#: rustmaps_vote.py:283
msgid "Map {map_id} added"
msgstr "Mapa {map_id} añadido correctamente"

#: rustmaps_vote.py:321
msgid "Set the global RustMaps API key."
msgstr "Configura la API key global de RustMaps."

#: rustmaps_vote.py:329
msgid "✅ RustMaps API key set."
msgstr "✅ API key de RustMaps configurada."

#: rustmaps_vote.py:335
msgid "Set how many maps each person can vote for per vote (default 1)."
msgstr ""
"Define cuántos mapas puede votar cada persona por votación (por defecto 1)."

#: rustmaps_vote.py:337
msgid "❌ The number of votes must be at least 1."
msgstr "❌ El número de votos debe ser al menos 1."

#: rustmaps_vote.py:341
msgid ""
"❌ The number of votes can't exceed the maximum number of maps ({MAX_MAPS})."
msgstr ""
"❌ El número de votos no puede superar el máximo de mapas ({MAX_MAPS})."

#: rustmaps_vote.py:354
msgid "✅ Each person can vote for **{amount}** map(s) per vote."
msgstr "✅ Cada persona podrá votar **{amount}** mapa(s) por votación."

#: rustmaps_vote.py:362
msgid "Add a map to the current vote."
msgstr "Añade un mapa a la votación actual."

#: rustmaps_vote.py:365
msgid ""
"❌ A vote is already running. End it with `[p]votemap end` before adding more"
" maps."
msgstr ""
"❌ Ya hay una votación en curso. Termínala con `[p]votemap end` antes de "
"añadir más mapas."

#: rustmaps_vote.py:372
msgid "❌ Set the API key first with `[p]votemap setapi <key>`."
msgstr "❌ Configura primero la API key con `[p]votemap setapi <key>`."

#: rustmaps_vote.py:395
msgid "❌ That map is already in the vote."
msgstr "❌ Ese mapa ya está en la votación."

#: rustmaps_vote.py:400
msgid "❌ You reached the maximum of {MAX_MAPS} maps per vote."
msgstr "❌ Has alcanzado el máximo de {MAX_MAPS} mapas por votación."

#: rustmaps_vote.py:412
msgid "Remove a map from the current vote (before it starts)."
msgstr "Quita un mapa de la votación actual (antes de empezar)."

#: rustmaps_vote.py:415
msgid "❌ You can't remove maps while a vote is running. Use `[p]votemap end`."
msgstr ""
"❌ No puedes quitar mapas con una votación en curso. Usa `[p]votemap end`."

#: rustmaps_vote.py:422
msgid "❌ No vote is being prepared."
msgstr "❌ No hay ninguna votación en preparación."

#: rustmaps_vote.py:426
msgid "❌ Map number {map_id} does not exist."
msgstr "❌ No existe el mapa número {map_id}."

#: rustmaps_vote.py:431
msgid "✅ Map removed. The vote was empty and has been cancelled."
msgstr "✅ Mapa quitado. La votación quedó vacía y se canceló."

#: rustmaps_vote.py:436
msgid "✅ Map removed. **{count}** map(s) left (renumbered from 1)."
msgstr ""
"✅ Mapa quitado. Quedan **{count}** mapa(s) (renumerados del 1 en adelante)."

#: rustmaps_vote.py:441
msgid "Show the maps of the current vote."
msgstr "Muestra los mapas de la votación actual."

#: rustmaps_vote.py:444
msgid "ℹ️ There is no active or prepared vote."
msgstr "ℹ️ No hay ninguna votación activa o en preparación."

#: rustmaps_vote.py:449
msgid "🗺️ Maps in the vote"
msgstr "🗺️ Mapas en la votación"

#: rustmaps_vote.py:453
msgid "🌱 Seed: `{seed}` • 📏 Size: `{size}` • [See map]({url})"
msgstr "🌱 Seed: `{seed}` • 📏 Size: `{size}` • [Ver mapa]({url})"

#: rustmaps_vote.py:455
msgid ""
"\n"
"🗳️ {vote_count} vote(s)"
msgstr ""
"\n"
"🗳️ {vote_count} voto(s)"

#: rustmaps_vote.py:457 rustmaps_vote.py:621
msgid "Running"
msgstr "En curso"

#: rustmaps_vote.py:457 rustmaps_vote.py:621
msgid "Being prepared"
msgstr "En preparación"

#: rustmaps_vote.py:459
msgid ""
"Status: {state} • {count}/{MAX_MAPS} maps • {max_votes_per_user} vote(s) per"
" person"
msgstr ""
"Estado: {state} • {count}/{MAX_MAPS} mapas • {max_votes_per_user} voto(s) "
"por persona"

#: rustmaps_vote.py:466
msgid "Start the vote with embeds and buttons."
msgstr "Inicia la votación con embeds y botones."

#: rustmaps_vote.py:468
msgid "❌ A vote is already running."
msgstr "❌ Ya hay una votación en curso."

#: rustmaps_vote.py:474
msgid ""
"❌ You need at least {MIN_MAPS} maps to start. Add them with `[p]votemap add "
"<url>`."
msgstr ""
"❌ Necesitas al menos {MIN_MAPS} mapas para empezar. Añádelos con `[p]votemap"
" add <url>`."

#: rustmaps_vote.py:513
msgid "✅ Vote started in {channel}!"
msgstr "✅ ¡Votación iniciada en {channel}!"

#: rustmaps_vote.py:515
msgid "✅ Vote started!"
msgstr "✅ ¡Votación iniciada!"

#: rustmaps_vote.py:520
msgid "End the vote, clean up the previous messages and announce the winner."
msgstr ""
"Termina la votación, limpia los mensajes anteriores y anuncia al ganador."

#: rustmaps_vote.py:525
msgid "❌ No vote is running."
msgstr "❌ No hay ninguna votación en curso."

#: rustmaps_vote.py:555
msgid "✅ Vote finished."
msgstr "✅ Votación finalizada."

#: rustmaps_vote.py:584
msgid "Cancel the current vote or preparation without announcing a winner."
msgstr "Cancela la votación o la preparación actual sin anunciar ganador."

#: rustmaps_vote.py:587
msgid "ℹ️ There is no vote to cancel."
msgstr "ℹ️ No hay ninguna votación que cancelar."

#: rustmaps_vote.py:592
msgid "🗑️ Vote cancelled."
msgstr "🗑️ Votación cancelada."

#: rustmaps_vote.py:597
msgid "Show the vote settings."
msgstr "Muestra la configuración de las votaciones."

#: rustmaps_vote.py:608
msgid "⚙️ RustMaps Vote settings"
msgstr "⚙️ Configuración de RustMaps Vote"

#: rustmaps_vote.py:609
msgid "🔑 API key"
msgstr "🔑 API key"

#: rustmaps_vote.py:609
msgid "✅ Set"
msgstr "✅ Configurada"

#: rustmaps_vote.py:609
msgid "❌ Not set"
msgstr "❌ Sin configurar"

#: rustmaps_vote.py:611
msgid "🗳️ Votes per person"
msgstr "🗳️ Votos por persona"

#: rustmaps_vote.py:616
msgid "📢 Vote channel"
msgstr "📢 Canal de votación"

#: rustmaps_vote.py:617
msgid "Channel where `start` is used"
msgstr "Canal donde se usa `start`"

#: rustmaps_vote.py:623 rustmaps_vote.py:628
msgid "📊 Current session"
msgstr "📊 Sesión actual"

#: rustmaps_vote.py:624
msgid ""
"Status: **{state}**\n"
"Maps: **{count}/{MAX_MAPS}**\n"
"Voters: **{total_voters}**"
msgstr ""
"Estado: **{state}**\n"
"Mapas: **{count}/{MAX_MAPS}**\n"
"Votantes: **{total_voters}**"

#: rustmaps_vote.py:628
msgid "None"
msgstr "Ninguna"

#: rustmaps_vote.py:637
msgid "Set the default channel for votes."
msgstr "Define el canal por defecto de las votaciones."

#: rustmaps_vote.py:640
msgid "✅ Votes will be posted in {channel}."
msgstr "✅ Las votaciones se publicarán en {channel}."

#: rustmaps_vote.py:644
msgid "✅ Votes will be posted in the channel where `start` is run."
msgstr "✅ Las votaciones se publicarán en el canal donde se ejecute `start`."

#: rustmaps_vote.py:677
msgid "⚠️ This vote has already ended."
msgstr "⚠️ Esta votación ya ha terminado."

#: rustmaps_vote.py:684
msgid "❌ Invalid map."
msgstr "❌ Mapa no válido."

#: rustmaps_vote.py:688
msgid ""
"⚠️ You already used all your votes ({max_votes_per_user}). Press a map you "
"already voted for again to free a vote."
msgstr ""
"⚠️ Ya has usado todos tus votos ({max_votes_per_user}). Pulsa de nuevo un "
"mapa que ya votaste para liberar un voto."

#: rustmaps_vote.py:698
msgid "✅ You voted for **Map {map_id}**."
msgstr "✅ Has votado por el **Mapa {map_id}**."

#: rustmaps_vote.py:702
msgid "↩️ You removed your vote from **Map {map_id}**."
msgstr "↩️ Has retirado tu voto del **Mapa {map_id}**."
