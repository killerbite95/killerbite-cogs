msgid ""
"**Map {map_id}** — Seed `{seed}`, Size `{size}`\n"
"🗳️ {vote_count} vote(s)\n"
"[See map]({url})"
msgstr ""
"**Mapa {map_id}** — Seed `{seed}`, Size `{size}`\n"
"🗳️ {vote_count} voto(s)\n"
"[Ver mapa]({url})"

