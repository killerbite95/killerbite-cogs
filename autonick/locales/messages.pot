#: autonick.py:23
#, docstring
msgid ""
"Lets users set their nickname by sending a message in a configured channel.\n"
"    The name is checked to block swear words and forbidden names (including dictators and celebrities).\n"
"\n"
"    Available commands (slash or prefix):\n"
"      • /autonick setchannel\n"
"      • /autonick setcooldown\n"
"      • /autonick info\n"
"      • /autonick admin addforbidden\n"
"      • /autonick admin removeforbidden\n"
"      • /autonick admin listforbidden\n"
"    "
msgstr ""

#: autonick.py:120
msgid ""
"{author}, you must wait {remaining} seconds before changing your nickname "
"again."
msgstr ""

#: autonick.py:132
msgid "{author}, the nickname can't be longer than 32 characters."
msgstr ""

#: autonick.py:139
msgid ""
"{author}, that name contains forbidden words or names. Please choose another"
" one."
msgstr ""

#: autonick.py:148
msgid "{author}, your nickname has been changed to: **{escape_markdown}**"
msgstr ""

#: autonick.py:153
msgid "{author}, I don't have permission to change your nickname."
msgstr ""

#: autonick.py:156
msgid "Error while changing the nickname: {e}"
msgstr ""

#: autonick.py:169
#, docstring
msgid ""
"Set the channel where nickname messages are read.\n"
"        Example: `/autonick setchannel #channel-name`\n"
"        "
msgstr ""

#: autonick.py:173
msgid "The AutoNick channel has been set to {channel}."
msgstr ""

#: autonick.py:178
#, docstring
msgid ""
"Set the cooldown (in seconds) between nickname changes.\n"
"        Example: `/autonick setcooldown 30`\n"
"        "
msgstr ""

#: autonick.py:182
msgid "The cooldown must be a positive number."
msgstr ""

#: autonick.py:184
msgid "The cooldown has been set to {seconds} seconds."
msgstr ""

